// Morphos — prediction market on robot morphology
// SQLite + Prisma. Markets are binary (YES/NO) milestone questions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  handle    String     @unique
  balance   Float      @default(1000) // play-money credits
  createdAt DateTime   @default(now())
  positions Position[]
  trades    Trade[]
}

model Market {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  description String
  category    String // e.g. "Mobility", "Manipulation", "Sensing", "Form"
  closesAt    DateTime // trading stops
  resolvesAt  DateTime // expected resolution
  // LMSR state
  b           Float      @default(150) // liquidity parameter
  qYes        Float      @default(0) // outstanding YES shares
  qNo         Float      @default(0) // outstanding NO shares
  volume      Float      @default(0) // total credits traded
  status      String     @default("OPEN") // OPEN | CLOSED | RESOLVED
  outcome     String? // YES | NO once resolved
  createdAt   DateTime   @default(now())
  positions   Position[]
  trades      Trade[]
}

model Position {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  market    Market   @relation(fields: [marketId], references: [id])
  marketId  String
  yesShares Float    @default(0)
  noShares  Float    @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, marketId])
}

// Community "Imagine a Form" submissions — speculative robot morphologies
// and the milestone markets people wish existed.
model Submission {
  id         String   @id @default(cuid())
  formName   String // the proposed robot form, e.g. "Modular wall-climbing octopod"
  morphology String   @default("humanoid") // closest RobotArt kind
  pitch      String // why this shape might win
  question   String? // a milestone market they'd want
  author     String   @default("anonymous")
  votes      Int      @default(0)
  createdAt  DateTime @default(now())
}

// Material innovation registry. Each material earns a hash-chained provenance
// trail (Registered → Tested → Adopted → Graduated). Events are causally
// ordered and tamper-evident — the HoTT idea applied to the supply chain.
model Material {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  innovator   String // who submitted it (person or org)
  category    String // e.g. "Tactile sensing", "Soft actuation", "Lightweight structure"
  morphology  String          @default("softgripper") // related RobotArt kind
  description String
  createdAt   DateTime        @default(now())
  events      MaterialEvent[]
}

model MaterialEvent {
  id         String   @id @default(cuid())
  material   Material @relation(fields: [materialId], references: [id])
  materialId String
  seq        Int // position in the chain (0-based)
  kind       String // Registered | Tested | Adopted | Graduated
  detail     String
  actor      String
  prevHash   String
  hash       String // sha256(prevHash + payload) — tamper-evident chain
  createdAt  DateTime @default(now())

  @@unique([materialId, seq])
}

// DIY builds: a maker publishes a robot with an OPEN bill of materials (which
// can reference registered Materials) plus steps. "Build this" logs a real
// consumption-pull event — the confirmed pull that makes the forecast market a
// true JIT/Kanban system. Pull events are hash-chained (tamper-evident).
model Build {
  id         String      @id @default(cuid())
  slug       String      @unique
  name       String
  author     String
  morphology String      @default("wheeled")
  summary    String
  steps      String // newline-separated instructions
  pulls      Int         @default(0) // "build this" count = consumption pull
  createdAt  DateTime    @default(now())
  bom        BomItem[]
  pullEvents PullEvent[]
}

model BomItem {
  id           String  @id @default(cuid())
  build        Build   @relation(fields: [buildId], references: [id])
  buildId      String
  part         String
  qty          Int     @default(1)
  materialSlug String? // optional link to a registered Material
}

model PullEvent {
  id        String   @id @default(cuid())
  build     Build    @relation(fields: [buildId], references: [id])
  buildId   String
  seq       Int
  actor     String
  prevHash  String
  hash      String
  createdAt DateTime @default(now())

  @@unique([buildId, seq])
}

model Trade {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  market    Market   @relation(fields: [marketId], references: [id])
  marketId  String
  outcome   String // YES | NO
  shares    Float // positive = buy, negative = sell
  cost      Float // credits paid (negative = received)
  priceYes  Float // YES price after the trade
  createdAt DateTime @default(now())
}
